{
  "name": "live-chat-overlay",
  "version": "3.0.0",
  "private": true,
  "author": "ASTOR",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable"
  },
  "dependencies": {
    "axios": "^1.2.0",
    "tiktok-live-connector": "^2.5.0",
    "youtube-chat": "^2.2.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "id.astor.livechatoverlay",
    "productName": "Live Chat Overlay",
    "artifactName": "${productName} 3.0.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}
